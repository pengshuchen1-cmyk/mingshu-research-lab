# 已完成 ICP 备案、并已将 A 记录解析到服务器公网 IP 的域名。
MINGSHU_DOMAIN=example.com

# 公网必须保持 public；不要改成 local。
MINGSHU_RUNTIME_MODE=public

# 备案通过后填写，应用会自动显示在所有页面底部。
MINGSHU_ICP_NUMBER=
MINGSHU_PUBLIC_SECURITY_NUMBER=

# Kimi AI。真实密钥只填写在服务器的 .env 中，禁止提交到 Git。
MINGSHU_AI_PROVIDER=kimi
MOONSHOT_API_KEY=replace-with-your-server-side-key
MINGSHU_AI_MODEL=kimi-k3
MINGSHU_AI_BASE_URL=https://api.moonshot.cn/v1
MINGSHU_AI_REASONING=low
MINGSHU_AI_TIMEOUT_SECONDS=90
