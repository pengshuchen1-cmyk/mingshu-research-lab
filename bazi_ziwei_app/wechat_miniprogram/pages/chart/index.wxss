.chart-empty { margin-top: 44rpx; padding: 46rpx 34rpx; text-align: center; }
.empty-title { display: block; margin-top: 18rpx; font-size: 46rpx; font-weight: 800; }
.empty-copy { display: block; margin: 20rpx 0 32rpx; color: var(--muted); font-size: 27rpx; line-height: 1.8; }
.archive-button { margin-top: 16rpx; }
.chart-actions { display: grid; grid-template-columns: 1fr 1fr 1.35fr; gap: 12rpx; margin-bottom: 24rpx; }
.chart-actions button { margin: 0; padding: 0 12rpx; font-size: 25rpx; }
.feature-list { display: grid; gap: 14rpx; }
.feature-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 25rpx 28rpx; }
.feature-row > view { flex: 1; }
.feature-name { display: block; font-size: 29rpx; font-weight: 800; }
.feature-copy { display: block; margin-top: 4rpx; color: var(--muted); font-size: 22rpx; }
.feature-arrow { color: var(--action); font-size: 34rpx; font-weight: 800; }
