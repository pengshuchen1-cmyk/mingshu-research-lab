.empty-title { display: block; margin-bottom: 24rpx; font-size: 38rpx; font-weight: 800; }
.kind-scroll { width: 100%; margin: 28rpx 0 18rpx; white-space: nowrap; }
.kind-row { display: inline-flex; gap: 12rpx; }
.kind-button { min-width: 170rpx; min-height: 76rpx; margin: 0; padding: 0 22rpx; background: var(--surface); border: 2rpx solid var(--line); border-radius: 14rpx; color: var(--muted); font-size: 25rpx; line-height: 76rpx; }
.kind-button.active { background: var(--ink); border-color: var(--ink); color: #FFFFFF; }
.export-bar { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 24rpx; padding: 24rpx; }
.export-bar > view:first-child { flex: 1; }
.export-title { display: block; font-weight: 800; }
.export-copy { display: block; margin-top: 3rpx; color: var(--muted); font-size: 21rpx; }
.export-buttons { display: flex; gap: 8rpx; }
.export-buttons button { min-width: 82rpx; min-height: 64rpx; margin: 0; padding: 0 10rpx; background: var(--action-soft); border: 2rpx solid #FBCFE8; border-radius: 12rpx; color: var(--action-dark); font-size: 21rpx; font-weight: 800; line-height: 64rpx; }
.preview { margin-top: 28rpx; padding: 28rpx; }
.preview-title { display: block; font-weight: 800; }
.preview-text { display: block; max-height: 600rpx; margin-top: 14rpx; overflow: auto; color: var(--muted); font-family: monospace; font-size: 22rpx; line-height: 1.65; white-space: pre-wrap; }
