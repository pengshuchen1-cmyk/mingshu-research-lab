ENVIRONMENT=development
DATABASE_URL=mysql+asyncmy://mingshu:1111111111111111111111111111111111111111111111111111111111111111@mysql:3306/mingshu?charset=utf8mb4
# Disposable Docker defaults only. Production DB/Redis passwords must be
# independently generated 64-character lowercase hexadecimal strings.
MYSQL_DATABASE=mingshu
MYSQL_USER=mingshu
MYSQL_PASSWORD=1111111111111111111111111111111111111111111111111111111111111111
MYSQL_ROOT_PASSWORD=2222222222222222222222222222222222222222222222222222222222222222
REDIS_PASSWORD=3333333333333333333333333333333333333333333333333333333333333333
JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters
JWT_ISSUER=mingshu-api
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
REGISTRATION_BONUS_POINTS=20
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_DAILY_LIMIT=10
OTP_MAX_ATTEMPTS=5
CORS_ORIGINS=["http://localhost:3000"]
REDIS_URL=redis://:3333333333333333333333333333333333333333333333333333333333333333@redis:6379/0
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
WECHAT_APP_ID=
WECHAT_APP_SECRET=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
