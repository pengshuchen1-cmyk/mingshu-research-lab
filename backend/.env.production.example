# Copy this file to /opt/mingshu-backend/.env on the target server and replace all placeholders.
ENVIRONMENT=production
# Generate each infrastructure password with `openssl rand -hex 32` and keep it
# as exactly 64 lowercase hexadecimal characters.
DATABASE_URL=
MYSQL_DATABASE=mingshu
MYSQL_USER=mingshu
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
REDIS_URL=
JWT_SECRET=
JWT_ISSUER=mingshu-api
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
REGISTRATION_BONUS_POINTS=20
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_DAILY_LIMIT=10
OTP_MAX_ATTEMPTS=5
PASSWORD_MAX_ATTEMPTS=5
PASSWORD_LOCK_MINUTES=15
PROFILE_EDIT_COOLDOWN_DAYS=30
APP_TIMEZONE=Asia/Shanghai
CORS_ORIGINS=["https://REPLACE_WITH_FRONTEND_DOMAIN"]
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
# Optional Docker build mirror; keep the official source unless the server route is slow.
PIP_INDEX_URL=https://pypi.org/simple
WECHAT_APP_ID=
WECHAT_APP_SECRET=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_REASONING_EFFORT=low
AI_TIMEOUT_SECONDS=30
AI_PER_USER_PER_MINUTE=3
AI_PER_USER_DAILY_REQUESTS=30
AI_DAILY_TOKEN_BUDGET=500000
AI_MAX_CONCURRENT_REQUESTS=4
