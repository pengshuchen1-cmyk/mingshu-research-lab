# Copy this file to .env when running the API natively on your workstation.
# First establish the SSH tunnel documented in 运维与Docker运行指南.md.
ENVIRONMENT=development
DATABASE_URL=mysql+asyncmy://mingshu:MYSQL_PASSWORD_64_LOWERCASE_HEX@127.0.0.1:13306/mingshu?charset=utf8mb4
REDIS_URL=redis://:REDIS_PASSWORD_64_LOWERCASE_HEX@127.0.0.1:16379/0
JWT_SECRET=local-development-only-change-before-production-2026
JWT_ISSUER=mingshu-api
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
REGISTRATION_BONUS_POINTS=20
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_DAILY_LIMIT=10
OTP_MAX_ATTEMPTS=5
PASSWORD_MAX_ATTEMPTS=5
PASSWORD_LOCK_MINUTES=15
PROFILE_EDIT_COOLDOWN_DAYS=30
APP_TIMEZONE=Asia/Shanghai
CORS_ORIGINS=["http://localhost:3000"]
WECHAT_APP_ID=
WECHAT_APP_SECRET=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
